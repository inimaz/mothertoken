---
import benchmark from "../data/benchmark";
import { GITHUB_URL, FLORES_URL } from "../constants";
---

<footer
  class="flex items-center justify-between pt-8 pb-12 mt-16 border-t border-border animate-fade-in-up stagger-4"
>
  <div class="flex gap-4">
    <span class="font-mono text-[14px] text-text-tertiary"
      >corpus <span class="text-text"><a href={FLORES_URL} target="_blank" rel="noopener noreferrer">flores-200</a></span>
    </span>
    <span class="text-[14px] text-border-strong">/</span>
    <span class="font-mono text-[14px] text-text-tertiary"
      >baseline <span class="text-text">english</span>
    </span>
  </div>
  <div class="flex gap-4">
    <a
      href={GITHUB_URL}
      class="inline-flex items-center gap-1.5 font-mono text-[14px] text-text-tertiary hover:text-text transition-colors duration-300 no-underline"
      aria-label="GitHub repository"
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 16 16"
        class="h-3.5 w-3.5 fill-current"
      >
        <path
          d="M8 0C3.58 0 0 3.67 0 8.2c0 3.62 2.29 6.69 5.47 7.78.4.08.55-.18.55-.4v-1.53c-2.23.49-2.7-.97-2.7-.97-.36-.95-.89-1.2-.89-1.2-.73-.51.06-.5.06-.5.8.06 1.23.85 1.23.85.72 1.26 1.88.9 2.34.69.07-.53.28-.9.51-1.1-1.78-.21-3.64-.92-3.64-4.07 0-.9.31-1.63.82-2.2-.08-.21-.36-1.04.08-2.17 0 0 .68-.22 2.2.84A7.42 7.42 0 0 1 8 3.95c.68 0 1.36.09 2 .27 1.53-1.06 2.2-.84 2.2-.84.44 1.13.16 1.96.08 2.17.51.57.82 1.3.82 2.2 0 3.16-1.87 3.86-3.65 4.06.29.26.54.76.54 1.53v2.27c0 .22.15.48.55.4A8.15 8.15 0 0 0 16 8.2C16 3.67 12.42 0 8 0Z"
        />
      </svg>
      <span>github↗</span>
    </a>
    <span class="text-[14px] text-border-strong">/</span>
    <span class="font-mono text-[14px] text-text-tertiary">mit license</span>
    <span class="text-[14px] text-border-strong">/</span>
    <span class="font-mono text-[14px] text-text-tertiary"
      >v{benchmark.version}
    </span>
  </div>
</footer>
